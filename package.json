    "url": "https://github.com/tgvashworth/tgvashworth.github.io/issues"
  },
  "homepage": "https://github.com/tgvashworth/tgvashworth.github.io#readme",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.28.2",
    "jkl": "0.1.0",
    "write-good": "^1.0.8"
  }
